{
  "name": "nyayachain-backend",
  "version": "1.0.0",
  "description": "NyayaChain secure document management backend",
  "scripts": {
    "start": "ts-node src/main.ts",
    "start:dev": "nodemon --watch src --ignore uploads --ignore dev.db --ignore dev.db-journal --ext ts --exec ts-node src/main.ts",
    "build": "tsc -p tsconfig.json",
    "db:migrate": "npx prisma migrate dev --name init",
    "db:seed": "ts-node prisma/seed.ts",
    "db:studio": "npx prisma studio",
    "db:push": "npx prisma db push"
  },
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^10.0.0",
    "@nestjs/passport": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "^5.0.0",
    "@types/pdfkit": "^0.17.6",
    "axios": "^1.20.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^17.4.2",
    "ethers": "^6.17.0",
    "form-data": "^4.0.6",
    "multer": "^1.4.5-lts.1",
    "passport": "^0.6.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pdfkit": "^0.20.2",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.0.0",
    "@types/passport-jwt": "^3.0.13",
    "@types/passport-local": "^1.0.38",
    "nodemon": "^3.0.0",
    "prisma": "^5.0.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.6"
  }
}
